# 复制为 .env.local 后填写（.env.local 不要提交）
# cp .env.example .env.local

# DeepSeek（邮件分析 / 周更 analyze / 可选 SPA 刷新）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 可选
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# 发邮件时才需要
# QQ_EMAIL=you@qq.com
# QQ_SMTP_PASS=your-smtp-auth-code

# SPA「刷新分析」鉴权（仅前端本地调试需要暴露给 Vite）
# ANALYZE_API_KEY=local-dev-secret
# VITE_ANALYZE_API_KEY=local-dev-secret
